# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# QR Code HMAC Secret (used server-side only, do NOT expose to client)
QR_HMAC_SECRET=your-hmac-secret-here

# Council Configuration (for multi-council replicability — Req 22.1)
# Change these values to deploy for a different BSP council.
# No source code modifications are needed.
VITE_COUNCIL_NAME=BSP Taguig City Council
VITE_COUNCIL_ID=taguig-city
VITE_COUNCIL_LOGO_URL=/icons.svg
VITE_COUNCIL_PRIMARY_COLOR=#1B5E20
VITE_COUNCIL_SECONDARY_COLOR=#FFD700
